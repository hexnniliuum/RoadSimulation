## Unity .gitattributes
## Normalize line endings and mark binaries so Windows checkouts (core.autocrlf=true)
## stop producing phantom "LF will be replaced by CRLF" diffs. Text lives as LF in
## both the repo and the working tree; the repo's history is already LF.

# Auto-detect text and force LF in the working tree (overrides core.autocrlf).
* text=auto eol=lf

# --- Source & shaders ---
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.uss       text eol=lf
*.uxml      text eol=lf

# --- Unity YAML assets ---
*.unity              text eol=lf
*.prefab             text eol=lf
*.asset              text eol=lf
*.mat                text eol=lf
*.meta               text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.physicMaterial     text eol=lf
*.physicsMaterial2D  text eol=lf
*.mask               text eol=lf
*.playable           text eol=lf
*.signal             text eol=lf
*.spriteatlas        text eol=lf
*.spriteatlasv2      text eol=lf
*.lighting           text eol=lf
*.guiskin            text eol=lf
*.fontsettings       text eol=lf
*.terrainlayer       text eol=lf
*.brush              text eol=lf

# --- Config & docs ---
*.json          text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.csv           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

